# Git Ignore for SGMC Project

# Material de origen archivado (no se versiona: PDFs, video, borradores)
archivo/
archivo/*

# Temporary python & scratch files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
scratch/

# Temporary Word lock files
~$*
~$*.docx

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
