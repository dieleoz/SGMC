# Git Ignore for SGMC Project

# Material de origen archivado (no se versiona: PDFs, video, borradores)
archivo/
archivo/*

# Documentos de contexto operativo. NO SE VERSIONAN.
# Tres de ellos son de otros corredores -ETRA en Neiva-Girardot, INDRA en otra
# doble calzada- y no son de esta Concesion. Se consultan en local; lo que
# aportan al modelo esta destilado en docs/CONTEXTO_OPERACION.md.
contexto/
contexto/*

# Temporary python & scratch files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
scratch/

# Temporary Word lock files
~$*
~$*.docx

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scripts de trabajo desechables
scripts/scratch_*.py

# Archivos de claves y credenciales (SEGUROS)
.env
.env.*
!.env.example
credentials.json
*_llaves.py
llaves.py


# Dependencias de Node. Nunca se versionan
node_modules/
package-lock.json

# Experimentos de automatizacion del editor de AppSheet por CDP/Playwright.
# No prosperaron: el cableado se acabo haciendo a mano en el editor y la
# comprobacion util resulto ser scripts/auditar_cableado.py, que lee el
# resultado por la API en vez de conducir el navegador. Se quedan en local
# para no perder el intento, pero no se versionan: seria legado desde el dia
# uno, y este repositorio se limpio el 2026-08-10 justo para no tener eso.
scripts/*.js
